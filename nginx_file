# Flyby AI backend — nginx reverse proxy
#
# Install on the EC2 host:
#   sudo cp nginx_file /etc/nginx/sites-available/autonomous
#   sudo ln -s /etc/nginx/sites-available/autonomous /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl restart nginx
#   sudo certbot --nginx        # adds the 443/TLS block automatically
#
# Already installed and certbot has run? Don't copy this file over the live one
# (that would drop certbot's TLS lines). Edit the live file instead: add the
# `map` block below at the top, and make the preflight lines match.
#
# The frontend is served from GitHub Pages on a DIFFERENT origin
# (https://rbrandt2006-hash.github.io, and https://flybyai.net once the custom
# domain is on), so every API call is cross-origin. Preflight (OPTIONS) is
# answered here; Flask-CORS sets the headers on the actual responses.

# Which sites may call the API from a browser. A preflight from any other
# origin gets no Allow-Origin header, so the browser refuses it. Keep this in
# step with the origins in __init__.py (and FRONTEND_ORIGINS).
map $http_origin $flyby_cors_origin {
    default                              "";
    "https://rbrandt2006-hash.github.io" $http_origin;
    "https://flybyai.net"                $http_origin;
    "https://www.flybyai.net"            $http_origin;
}

server {
    listen 80;
    listen [::]:80;
    server_name hungerheros.opencodingsociety.com;

    # Receipt and avatar uploads go up to 10 MB (MAX_CONTENT_LENGTH in the app).
    # nginx defaults to 1 MB and would reject them with 413 without this.
    client_max_body_size 10M;

    location / {
        proxy_pass http://localhost:8659;

        # Pass the real client/scheme through so the app logs and builds URLs
        # correctly behind the proxy.
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Flight search and AI calls can take a while upstream.
        proxy_connect_timeout 60s;
        proxy_read_timeout    120s;
        proxy_send_timeout    120s;

        # Preflighted requests: echo the caller's origin when it is one of ours.
        if ($request_method = OPTIONS) {
            add_header "Access-Control-Allow-Credentials" "true" always;
            add_header "Access-Control-Allow-Origin"  $flyby_cors_origin always;
            add_header "Vary" "Origin" always;
            add_header "Access-Control-Allow-Methods" "GET, POST, PUT, PATCH, DELETE, OPTIONS, HEAD" always;
            add_header "Access-Control-Max-Age" 600 always;
            add_header "Access-Control-Allow-Headers" "Authorization, Origin, X-Origin, X-Requested-With, Content-Type, Accept, Prefer, X-Client-Info" always;
            return 204;
        }
    }
}
