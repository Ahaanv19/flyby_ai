# Flyby AI — backend configuration
#
# Copy to .env and adjust. Every value has a working default, so the backend
# runs with no .env at all — the settings below are for changing behaviour, not
# for making it start.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
# Signs session cookies and auth tokens. CHANGE THIS before deploying: anyone
# who knows it can mint valid tokens for any account.
SECRET_KEY="flyby-dev-secret-change-me"

# Port for the API and the operations console.
FLASK_PORT=8659

# ---------------------------------------------------------------------------
# Seeded accounts (created on first run)
# ---------------------------------------------------------------------------
ADMIN_USER="admin@flyby.ai"
ADMIN_PASSWORD="Flyby!2024"
DEFAULT_USER="demo@flyby.ai"
DEFAULT_PASSWORD="Flyby!2024"

# ---------------------------------------------------------------------------
# Token lifetimes (seconds)
# ---------------------------------------------------------------------------
# Access tokens are short-lived; the frontend refreshes them silently.
JWT_ACCESS_TTL_SECONDS=3600
JWT_REFRESH_TTL_SECONDS=2592000

# ---------------------------------------------------------------------------
# Frontend origins
# ---------------------------------------------------------------------------
# Only needed when the frontend is served from a host that isn't localhost.
# In development the Vite dev server proxies to this backend, so the browser is
# same-origin and this can stay empty.
# FRONTEND_ORIGINS="https://app.flyby.example.com"

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Unset, the backend uses SQLite at instance/volumes/flyby.db.
# Set all three to use MySQL instead.
# DB_ENDPOINT=""
# DB_USERNAME=""
# DB_PASSWORD=""

# ---------------------------------------------------------------------------
# Optional integrations — every one degrades gracefully when unset
# ---------------------------------------------------------------------------
# SMS delivery for two-step verification. Without these, the verification code
# is printed to the backend console so the flow is still testable locally.
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_FROM_NUMBER=""

# Voice transcription (Whisper). Without it, dictation reports that it needs a key.
# OPENAI_API_KEY=""

# ---------------------------------------------------------------------------
# Admin hardening (optional)
# ---------------------------------------------------------------------------
# Restrict the admin console to specific IPs, comma separated.
# ADMIN_IP_ALLOWLIST="127.0.0.1"
# Honour X-Forwarded-For (only enable behind a trusted proxy).
# TRUST_PROXY="false"
